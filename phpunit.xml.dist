<?xml version="1.0"?>
<phpunit
	bootstrap="tests/bootstrap.php"
	colors="true"
	beStrictAboutOutputDuringTests="true"
	failOnRisky="true"
	failOnWarning="true">
	<testsuites>
		<testsuite name="rehearsal">
			<directory suffix="Test.php">rehearsal/tests</directory>
		</testsuite>
		<testsuite name="jn-ledger">
			<directory suffix="Test.php">tests</directory>
		</testsuite>
	</testsuites>
</phpunit>
